    "    if (options.encoding !== undefined && fsEncoding(options.encoding, operation) !== 'utf8') {",
    "      throw unsupported(operation + ' encoding: ' + options.encoding);",
    "    }",
    "    return { withFileTypes: options.withFileTypes === true };",
    "  }",
    "  function fsDirent(name, parentPath, kind) {",
    "    return {",
    "      name: name,",
    "      parentPath: parentPath,",
    "      isFile: function () { return kind === 'file'; },",
    "      isDirectory: function () { return kind === 'directory'; },",
    "      isSymbolicLink: function () { return kind === 'symlink'; },",
    "    };",
    "  }",
    "  function fsReaddir(pathValue, options, operation) {",
    "    const path = fsPath(pathValue, operation);",
    "    const parsed = fsReaddirOptions(options, operation);",
    "    const reply = fsRequest('main-read-dir', { path: path });",
    "    if (typeof reply.path !== 'string' || !Array.isArray(reply.entries)) throw fail('EIO', operation);",
    "    const result = [];",
    "    for (let i = 0; i < reply.entries.length; i++) {",
    "      const entry = reply.entries[i];",
    "      if (!entry || typeof entry.name !== 'string' || typeof entry.kind !== 'string') {",
    "        throw fail('EIO', operation);",
    "      }",
    "      result.push(parsed.withFileTypes ? fsDirent(entry.name, reply.path, entry.kind) : entry.name);",
    "    }",
    "    return result;",
    "  }",
    "  function fsMkdirOptions(options, operation) {",
    "    if (options === undefined || options === null) return { recursive: false };",
    "    if (typeof options !== 'object') throw fail('EINVAL', operation);",
    "    if (options.recursive !== undefined && typeof options.recursive !== 'boolean') throw fail('EINVAL', operation);",
    "    if (options.mode !== undefined) throw unsupported(operation + ' mode');",
    "    if (options.signal !== undefined) throw unsupported(operation + ' signal');",
    "    return { recursive: options.recursive === true };",
    "  }",
    "  function fsMkdir(pathValue, options, operation) {",
    "    const path = fsPath(pathValue, operation);",
    "    const parsed = fsMkdirOptions(options, operation);",
    "    const reply = fsRequest('main-mkdir', { path: path, recursive: parsed.recursive });",
    "    if (parsed.recursive && typeof reply.firstCreated === 'string' && reply.firstCreated.length > 0) {",
    "      return reply.firstCreated;",
    "    }",
    "    return undefined;",
    "  }",
    "  function fsExists(pathValue) {",
    "    if (typeof pathValue !== 'string' || pathValue.length > 4096 || pathValue.indexOf('\\u0000') >= 0) {",
    "      throw fail('EINVAL', 'fs.existsSync');",
    "    }",
    "    if (pathValue.length === 0) return false;",
    "    try {",
    "      const reply = hostRequest('main-stat', { path: pathValue });",
    "      return reply.exists === true;",
    "    } catch (_) { return false; }",
    "  }",
    "  const fsBuiltin = {",
    "    existsSync: fsExists,",
    "    readFileSync: function (pathValue, options) { return fsRead(pathValue, options, 'fs.readFileSync'); },",
    "    writeFileSync: function (pathValue, data, options) { fsWrite(pathValue, data, options, 'fs.writeFileSync'); },",
    "    statSync: function (pathValue, options) { return fsStat(pathValue, options, 'fs.statSync'); },",
    "    readdirSync: function (pathValue, options) { return fsReaddir(pathValue, options, 'fs.readdirSync'); },",
    "    mkdirSync: function (pathValue, options) { return fsMkdir(pathValue, options, 'fs.mkdirSync'); },",
    "  };",
    "  const fsPromises = {",
    "    readFile: function (pathValue, options) {",
    "      return new Promise(function (resolve, reject) {",
    "        try { resolve(fsRead(pathValue, options, 'fs.promises.readFile')); } catch (error) { reject(error); }",
    "      });",
    "    },",
    "    writeFile: function (pathValue, data, options) {",
    "      return new Promise(function (resolve, reject) {",
    "        try { fsWrite(pathValue, data, options, 'fs.promises.writeFile'); resolve(); } catch (error) { reject(error); }",
    "      });",
    "    },",
    "    stat: function (pathValue, options) {",
    "      return new Promise(function (resolve, reject) {",
    "        try { resolve(fsStat(pathValue, options, 'fs.promises.stat')); } catch (error) { reject(error); }",
    "      });",
    "    },",
    "    readdir: function (pathValue, options) {",
    "      return new Promise(function (resolve, reject) {",
    "        try { resolve(fsReaddir(pathValue, options, 'fs.promises.readdir')); } catch (error) { reject(error); }",
    "      });",
    "    },",
    "    mkdir: function (pathValue, options) {",
    "      return new Promise(function (resolve, reject) {",
    "        try { resolve(fsMkdir(pathValue, options, 'fs.promises.mkdir')); } catch (error) { reject(error); }",
    "      });",
    "    },",
    "  };",
    "  fsBuiltin.promises = fsPromises;",
    "  const zlibBuiltin = {",
    "    createDeflate: function () { throw unsupported('zlib.createDeflate'); },",
    "  };",
    "  const updater = {",
    "    autoUpdater: {",
    "      allowPrerelease: false,",
    "      on: function () {},",
    "      checkForUpdates: function () { return Promise.reject(unsupported('autoUpdater.checkForUpdates')); },",
    "      downloadUpdate: function () { return Promise.reject(unsupported('autoUpdater.downloadUpdate')); },",
    "      quitAndInstall: function () {},",
    "    },",
    "  };",
    "",
    "  // ---- builtins ----",
    "  const builtins = Object.create(null);",
    "  builtins.electron = electron;",
    "  builtins['node:path'] = path; builtins.path = path;",
    "  builtins['node:url'] = url; builtins.url = url;",
    "  builtins['node:process'] = processShim; builtins.process = processShim;",
    "  builtins['node:events'] = events; builtins.events = events;",
    "  builtins['node:buffer'] = bufferModule; builtins.buffer = bufferModule;",
    "  builtins['node:fs'] = fsBuiltin; builtins.fs = fsBuiltin;",
    "  builtins['node:fs/promises'] = fsPromises; builtins['fs/promises'] = fsPromises;",
    "  builtins['node:zlib'] = zlibBuiltin; builtins.zlib = zlibBuiltin;",
    "  builtins['electron-updater'] = updater;",
    "",
    "  globalThis.__mbt_builtins = builtins;",
    "  globalThis.__mbt_process = processShim;",
    "  globalThis.__mbt_Buffer = Buffer;",
    "  globalThis.__mbt_app_ready = markAppReady;",
    "  globalThis.__mbt_dispatch = dispatch;",
    "  globalThis.__mbt_take_pending = takePending;",
    "  globalThis.__mbt_sync_timers = syncTimers;",
    "  globalThis.__mbt_fire_timer = fireTimer;",
    "  globalThis.__mbt_drain_next_tick = drainNextTick;",
    "  globalThis.process = processShim;",
    "  globalThis.Buffer = Buffer;",
    "  globalThis.global = globalThis;",
    "  globalThis.setTimeout = setTimeoutShim;",
    "  globalThis.clearTimeout = clearTimeoutShim;",
    "  globalThis.queueMicrotask = function (callback) { Promise.resolve().then(callback); };",
    "  globalThis.setInterval = function () { throw unsupported('setInterval'); };",
    "  globalThis.setImmediate = function () { throw unsupported('setImmediate'); };",
    "})();",
  ].join("\n")
}
