// JS leaf glue for the bounded Node/Electron surface. The module cache,
// lifecycle, request ledger, scheduler deadlines and limits stay in MoonBit.
// This file must not grow a second loader or a second lifecycle.

///|
pub fn node_prelude() -> String {
  [
    "(function () {",
    "  'use strict';",
    "  const config = globalThis.__mbt_config || {};",
    "  const appConfig = config.app || {};",
    "  const processConfig = config.process || {};",
    "  const limitConfig = config.limits || {};",
    "  const maxTimers = typeof limitConfig.timers === 'number' ? limitConfig.timers : 1024;",
    "  function has(object, key) { return Object.prototype.hasOwnProperty.call(object, key); }",
    "  function fail(code, message) { const error = new Error(message || code); error.code = code; return error; }",
    "  function unsupported(name) { return fail('ELECTRON_MBT_UNSUPPORTED_API', 'unsupported API: ' + name); }",
    "",
    "  // ---- path (POSIX only) ----",
    "  const path = { sep: '/', delimiter: ':' };",
    "  path.normalize = function (value) {",
    "    if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.normalize');",
    "    const absolute = value.charAt(0) === '/';",
    "    const parts = [];",
    "    const pieces = value.split('/');",
    "    for (let i = 0; i < pieces.length; i++) {",
    "      const piece = pieces[i];",
    "      if (!piece || piece === '.') continue;",
    "      if (piece === '..') { if (parts.length && parts[parts.length - 1] !== '..') parts.pop(); else if (!absolute) parts.push('..'); }",
    "      else parts.push(piece);",
    "    }",
    "    const joined = parts.join('/');",
    "    if (absolute) return '/' + joined;",
    "    return joined || '.';",
    "  };",
    "  path.isAbsolute = function (value) { return typeof value === 'string' && value.charAt(0) === '/'; };",
    "  path.join = function () {",
    "    let absolute = false;",
    "    const parts = [];",
    "    for (let i = 0; i < arguments.length; i++) {",
    "      const value = arguments[i];",
    "      if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.join');",
    "      if (i === 0 && value.charAt(0) === '/') absolute = true;",
    "      const pieces = value.split('/');",
    "      for (let j = 0; j < pieces.length; j++) {",
    "        const piece = pieces[j];",
    "        if (!piece || piece === '.') continue;",
    "        if (piece === '..') { if (parts.length && parts[parts.length - 1] !== '..') parts.pop(); else if (!absolute) parts.push('..'); }",
    "        else parts.push(piece);",
    "      }",
    "    }",
    "    const joined = parts.join('/');",
    "    return (absolute ? '/' : '') + joined;",
    "  };",
    "  path.dirname = function (value) {",
    "    if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.dirname');",
    "    const normalized = path.normalize(value);",
    "    const index = normalized.lastIndexOf('/');",
    "    if (index < 0) return '.';",
    "    if (index === 0) return '/';",
    "    return normalized.slice(0, index);",
    "  };",
    "  path.basename = function (value, suffix) {",
    "    if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.basename');",
    "    const normalized = path.normalize(value);",
    "    const index = normalized.lastIndexOf('/');",
    "    let base = index < 0 ? normalized : normalized.slice(index + 1);",
    "    if (typeof suffix === 'string' && suffix.length > 0 && base.length > suffix.length && base.slice(base.length - suffix.length) === suffix) {",
    "      base = base.slice(0, base.length - suffix.length);",
    "    }",
    "    return base;",
    "  };",
    "  path.extname = function (value) {",
    "    if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.extname');",
    "    const base = path.basename(value);",
    "    const index = base.lastIndexOf('.');",
    "    if (index <= 0) return '';",
    "    return base.slice(index);",
    "  };",
    "  path.resolve = function () {",
    "    let resolved = '';",
    "    for (let i = arguments.length - 1; i >= -1; i--) {",
    "      const value = i >= 0 ? arguments[i] : processShim.cwd();",
    "      if (typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'path.resolve');",
    "      if (!value) continue;",
    "      resolved = value + (resolved ? '/' + resolved : '');",
    "      if (value.charAt(0) === '/') break;",
    "    }",
    "    return path.normalize(resolved || '/');",
    "  };",
    "",
    "  // ---- url (file helpers only) ----",
    "  const url = {};",
    "  url.fileURLToPath = function (value) {",
    "    const text = String(value);",
    "    if (text.slice(0, 7) !== 'file://') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'fileURLToPath');",
    "    let rest = text.slice(7);",
    "    if (rest.charAt(0) !== '/') {",
    "      const slash = rest.indexOf('/');",
    "      if (slash < 0) throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'fileURLToPath host');",
    "      rest = rest.slice(slash);",
    "    }",
    "    try { return decodeURIComponent(rest); } catch (error) { throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'fileURLToPath encoding'); }",
    "  };",
    "  url.pathToFileURL = function (value) {",
    "    const text = String(value);",
    "    if (text.charAt(0) !== '/') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'pathToFileURL');",
    "    return 'file://' + encodeURI(text).replace(/#/g, '%23').replace(/\\?/g, '%3F');",
    "  };",
    "",
    "  // ---- process ----",
    "  const nextTickQueue = [];",
    "  const processShim = {",
    "    platform: processConfig.platform || 'unknown',",
    "    arch: processConfig.arch || 'unknown',",
    "    argv: Array.isArray(processConfig.argv) ? processConfig.argv.slice() : [],",
    "    env: Object.assign(Object.create(null), processConfig.env || {}),",
    "    resourcesPath: processConfig.resourcesPath || appConfig.appPath || '.',",
    "    versions: Object.freeze(Object.assign({}, processConfig.versions || {})),",
    "    cwd: function () { return processConfig.cwd || appConfig.appPath || '.'; },",
    "    nextTick: function (callback) {",
    "      if (typeof callback !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'process.nextTick');",
    "      if (nextTickQueue.length >= 1024) throw fail('ELECTRON_MBT_TIMER_LIMIT', 'process.nextTick');",
    "      nextTickQueue.push(callback);",
    "    },",
    "    exit: function () { throw unsupported('process.exit'); },",
    "    on: function () { return processShim; },",
    "  };",
    "  function drainNextTick() {",
    "    while (nextTickQueue.length > 0) {",
    "      const callback = nextTickQueue.shift();",
    "      callback();",
    "    }",
    "  }",
    "",
    "  // ---- timers ----",
    "  const timers = Object.create(null);",
    "  let nextTimer = 1;",
    "  function Timeout(id) { this._id = id; this._ref = true; }",
    "  Timeout.prototype.ref = function () { this._ref = true; return this; };",
    "  Timeout.prototype.unref = function () { this._ref = false; return this; };",
    "  Timeout.prototype.hasRef = function () { return this._ref; };",
    "  function setTimeoutShim(callback, delay) {",
    "    if (typeof callback !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'setTimeout');",
    "    if (Object.keys(timers).length >= maxTimers) throw fail('ELECTRON_MBT_TIMER_LIMIT', 'setTimeout');",
    "    const id = nextTimer++;",
    "    const timeout = new Timeout(id);",
    "    timers[id] = { id: id, delay: Number(delay) || 0, callback: callback, timeout: timeout };",
    "    return timeout;",
    "  }",
    "  function clearTimeoutShim(timeout) {",
    "    if (!timeout || typeof timeout._id !== 'number') return;",
    "    delete timers[timeout._id];",
    "  }",
    "  function syncTimers() {",
    "    const out = [];",
    "    const ids = Object.keys(timers);",
    "    for (let i = 0; i < ids.length; i++) {",
    "      const id = ids[i];",
    "      const timer = timers[id];",
    "      out.push({ id: timer.id, delay: timer.delay, ref: timer.timeout._ref });",
    "    }",
    "    return JSON.stringify(out);",
    "  }",
    "  function fireTimer(id) {",
    "    const timer = timers[id];",
    "    if (!timer) return '';",
    "    delete timers[id];",
    "    timer.callback();",
    "    return 'ok';",
    "  }",
    "",
    "  // ---- Buffer ----",
    "  function utf8Encode(text) {",
    "    const out = [];",
    "    for (let i = 0; i < text.length; i++) {",
    "      let code = text.charCodeAt(i);",
    "      if (code >= 0xD800 && code <= 0xDBFF && i + 1 < text.length) {",
    "        const low = text.charCodeAt(i + 1);",
    "        if (low >= 0xDC00 && low <= 0xDFFF) { code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00); i += 1; }",
    "      }",
    "      if (code < 0x80) out.push(code);",
    "      else if (code < 0x800) out.push(0xC0 | (code >> 6), 0x80 | (code & 63));",
    "      else if (code < 0x10000) out.push(0xE0 | (code >> 12), 0x80 | ((code >> 6) & 63), 0x80 | (code & 63));",
    "      else out.push(0xF0 | (code >> 18), 0x80 | ((code >> 12) & 63), 0x80 | ((code >> 6) & 63), 0x80 | (code & 63));",
    "    }",
    "    return out;",
    "  }",
    "  function utf8Decode(bytes) {",
    "    let out = '';",
    "    for (let i = 0; i < bytes.length; i++) {",
    "      const first = bytes[i];",
    "      let code = 0xFFFD;",
    "      if (first < 0x80) { code = first; }",
    "      else if (first >= 0xC2 && first < 0xE0 && i + 1 < bytes.length) { code = ((first & 31) << 6) | (bytes[i + 1] & 63); i += 1; }",
    "      else if (first >= 0xE0 && first < 0xF0 && i + 2 < bytes.length) { code = ((first & 15) << 12) | ((bytes[i + 1] & 63) << 6) | (bytes[i + 2] & 63); i += 2; }",
    "      else if (first >= 0xF0 && first < 0xF5 && i + 3 < bytes.length) { code = ((first & 7) << 18) | ((bytes[i + 1] & 63) << 12) | ((bytes[i + 2] & 63) << 6) | (bytes[i + 3] & 63); i += 3; }",
    "      if (code > 0xFFFF) { code -= 0x10000; out += String.fromCharCode(0xD800 + (code >> 10), 0xDC00 + (code & 1023)); }",
    "      else out += String.fromCharCode(code);",
    "    }",
    "    return out;",
    "  }",
    "  const b64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';",
    "  function base64Encode(bytes) {",
    "    let out = '';",
    "    for (let i = 0; i < bytes.length; i += 3) {",
    "      const a = bytes[i]; const b = i + 1 < bytes.length ? bytes[i + 1] : 0; const c = i + 2 < bytes.length ? bytes[i + 2] : 0;",
    "      out += b64.charAt(a >> 2); out += b64.charAt(((a & 3) << 4) | (b >> 4));",
    "      out += i + 1 < bytes.length ? b64.charAt(((b & 15) << 2) | (c >> 6)) : '=';",
    "      out += i + 2 < bytes.length ? b64.charAt(c & 63) : '=';",
    "    }",
    "    return out;",
    "  }",
    "  function base64Decode(text) {",
    "    const clean = String(text).replace(/[^A-Za-z0-9+/=]/g, '');",
    "    const out = [];",
    "    let bits = 0; let value = 0;",
    "    for (let i = 0; i < clean.length; i++) {",
    "      const ch = clean.charAt(i);",
    "      if (ch === '=') break;",
    "      const digit = b64.indexOf(ch);",
    "      if (digit < 0) continue;",
    "      value = (value << 6) | digit; bits += 6;",
    "      if (bits >= 8) { bits -= 8; out.push((value >> bits) & 255); }",
    "    }",
    "    return out;",
    "  }",
    "  function asciiEncode(text) { const out = []; for (let i = 0; i < text.length; i++) out.push(text.charCodeAt(i) & 255); return out; }",
    "  function asciiDecode(bytes) {",
    "    let out = '';",
    "    for (let i = 0; i < bytes.length; i += 1024) { out += String.fromCharCode.apply(null, bytes.slice(i, i + 1024)); }",
    "    return out;",
    "  }",
    "  function bytesFor(value, encoding) {",
    "    if (typeof value === 'string') {",
    "      const kind = encoding || 'utf8';",
    "      if (kind === 'utf8' || kind === 'utf-8') return utf8Encode(value);",
    "      if (kind === 'base64') return base64Decode(value);",
    "      if (kind === 'ascii') return asciiEncode(value);",
    "      throw fail('ELECTRON_MBT_UNSUPPORTED_API', 'Buffer.from encoding: ' + kind);",
    "    }",
    "    if (value instanceof Uint8Array) return Array.prototype.slice.call(value);",
    "    if (Array.isArray(value)) return value.slice();",
    "    throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'Buffer.from');",
    "  }",
    "  function Buffer(arg) {",
    "    const bytes = typeof arg === 'number' ? new Uint8Array(arg) : new Uint8Array(arg);",
    "    Object.setPrototypeOf(bytes, Buffer.prototype);",
    "    return bytes;",
    "  }",
    "  Buffer.prototype = Object.create(Uint8Array.prototype);",
    "  Buffer.prototype.constructor = Buffer;",
    "  Buffer.prototype.toString = function (encoding, start, end) {",
    "    const kind = encoding || 'utf8';",
    "    const first = typeof start === 'number' ? start : 0;",
    "    const last = typeof end === 'number' ? end : this.length;",
    "    const bytes = Array.prototype.slice.call(this.subarray(first, last));",
    "    if (kind === 'utf8' || kind === 'utf-8') return utf8Decode(bytes);",
    "    if (kind === 'ascii') return asciiDecode(bytes);",
    "    if (kind === 'base64') return base64Encode(bytes);",
    "    throw fail('ELECTRON_MBT_UNSUPPORTED_API', 'Buffer.toString encoding: ' + kind);",
    "  };",
    "  Buffer.prototype.equals = function (other) {",
    "    if (!(other instanceof Uint8Array) || other.length !== this.length) return false;",
    "    for (let i = 0; i < this.length; i++) if (this[i] !== other[i]) return false;",
    "    return true;",
    "  };",
    "  Buffer.from = function (value, encoding) { return Buffer(bytesFor(value, encoding)); };",
    "  Buffer.alloc = function (size, fill) {",
    "    if (typeof size !== 'number' || size < 0 || size > 67108864) throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'Buffer.alloc');",
    "    const buffer = new Buffer(size);",
    "    if (fill !== undefined) buffer.fill(fill);",
    "    return buffer;",
    "  };",
    "  Buffer.allocUnsafe = function (size) { return Buffer.alloc(size); };",
    "  Buffer.concat = function (list, totalLength) {",
    "    if (!Array.isArray(list)) throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'Buffer.concat');",
    "    let total = 0;",
    "    for (let i = 0; i < list.length; i++) total += list[i].length;",
    "    if (typeof totalLength === 'number') total = totalLength;",
    "    const out = new Buffer(total);",
    "    let offset = 0;",
    "    for (let i = 0; i < list.length && offset < total; i++) { out.set(list[i], offset); offset += list[i].length; }",
    "    return out;",
    "  };",
    "  Buffer.isBuffer = function (value) { return value instanceof Buffer; };",
    "  Buffer.byteLength = function (value, encoding) { return bytesFor(value, encoding).length; };",
    "",
    "  // ---- events ----",
    "  function EventEmitter() { this._events = Object.create(null); }",
    "  EventEmitter.prototype.on = function (name, listener) {",
    "    if (typeof listener !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'EventEmitter.on');",
    "    const list = this._events[name] || (this._events[name] = []);",
    "    list.push(listener);",
    "    return this;",
    "  };",
    "  EventEmitter.prototype.addListener = EventEmitter.prototype.on;",
    "  EventEmitter.prototype.once = function (name, listener) {",
    "    if (typeof listener !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'EventEmitter.once');",
    "    const self = this;",
    "    function wrapper() { self.off(name, wrapper); return listener.apply(self, arguments); }",
    "    wrapper.listener = listener;",
    "    return this.on(name, wrapper);",
    "  };",
    "  EventEmitter.prototype.off = function (name, listener) {",
    "    const list = this._events[name];",
    "    if (!list) return this;",
    "    for (let i = 0; i < list.length; i++) {",
    "      if (list[i] === listener || list[i].listener === listener) { list.splice(i, 1); break; }",
    "    }",
    "    return this;",
    "  };",
    "  EventEmitter.prototype.removeListener = EventEmitter.prototype.off;",
    "  EventEmitter.prototype.removeAllListeners = function (name) {",
    "    if (name === undefined) this._events = Object.create(null);",
    "    else delete this._events[name];",
    "    return this;",
    "  };",
    "  EventEmitter.prototype.listenerCount = function (name) { const list = this._events[name]; return list ? list.length : 0; };",
    "  EventEmitter.prototype.emit = function (name) {",
    "    const list = this._events[name];",
    "    if (!list || list.length === 0) {",
    "      if (name === 'error') throw arguments[1] instanceof Error ? arguments[1] : new Error('Unhandled error event');",
    "      return false;",
    "    }",
    "    const args = Array.prototype.slice.call(arguments, 1);",
    "    const copy = list.slice();",
    "    for (let i = 0; i < copy.length; i++) copy[i].apply(this, args);",
    "    return true;",
    "  };",
    "  const events = { EventEmitter: EventEmitter };",
    "  const bufferModule = { Buffer: Buffer };",
    "",
    "  // ---- electron app / ipcMain ----",
    "  const appEvents = Object.create(null);",
    "  const appPaths = Object.assign({}, appConfig.paths || {});",
    "  let appReady = false;",
    "  let readyResolve = null;",
    "  const readyPromise = new Promise(function (resolve) { readyResolve = resolve; });",
    "  const app = {",
    "    name: typeof appConfig.name === 'string' ? appConfig.name : 'nodeless-app',",
    "    isPackaged: false,",
    "    whenReady: function () { return readyPromise; },",
    "    isReady: function () { return appReady; },",
    "    getVersion: function () { return typeof appConfig.version === 'string' ? appConfig.version : '0.0.0'; },",
    "    getLocale: function () { return typeof appConfig.locale === 'string' ? appConfig.locale : 'en'; },",
    "    getName: function () { return app.name; },",
    "    setName: function (value) { if (typeof value === 'string') app.name = value; },",
    "    setDesktopName: function () {},",
    "    getAppPath: function () { return appConfig.appPath || '.'; },",
    "    getPath: function (name) {",
    "      if (typeof name === 'string' && has(appPaths, name)) return appPaths[name];",
    "      throw unsupported('app.getPath:' + String(name));",
    "    },",
    "    setPath: function (name, value) {",
    "      if (typeof name !== 'string' || typeof value !== 'string') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'app.setPath');",
    "      appPaths[name] = value;",
    "    },",
    "    requestSingleInstanceLock: function () { return true; },",
    "    releaseSingleInstanceLock: function () {},",
    "    on: function (name, listener) {",
    "      if (typeof listener !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'app.on');",
    "      const list = appEvents[name] || (appEvents[name] = []);",
    "      list.push(listener);",
    "      if (name === 'ready' && appReady) listener();",
    "      return app;",
    "    },",
    "    once: function (name, listener) {",
    "      const self = this;",
    "      function wrapper() { self.removeListener(name, wrapper); return listener.apply(self, arguments); }",
    "      wrapper.listener = listener;",
    "      return this.on(name, wrapper);",
    "    },",
    "    removeListener: function (name, listener) {",
    "      const list = appEvents[name];",
    "      if (!list) return app;",
    "      for (let i = 0; i < list.length; i++) if (list[i] === listener || list[i].listener === listener) { list.splice(i, 1); break; }",
    "      return app;",
    "    },",
    "    quit: function () { appReady = false; },",
    "  };",
    "  function markAppReady() {",
    "    if (appReady) return 'ok';",
    "    appReady = true;",
    "    const list = appEvents.ready ? appEvents.ready.slice() : [];",
    "    for (let i = 0; i < list.length; i++) list[i]();",
    "    if (readyResolve) { readyResolve(); readyResolve = null; }",
    "    return 'ok';",
    "  }",
    "  const ipcHandlers = Object.create(null);",
    "  const ipcListeners = Object.create(null);",
    "  const ipcMain = {",
    "    handle: function (channel, handler) {",
    "      if (typeof channel !== 'string' || channel.length === 0 || typeof handler !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'ipcMain.handle');",
    "      if (has(ipcHandlers, channel)) throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'ipcMain.handle duplicate');",
    "      ipcHandlers[channel] = handler;",
    "    },",
    "    removeHandler: function (channel) { delete ipcHandlers[channel]; },",
    "    on: function (channel, listener) {",
    "      if (typeof listener !== 'function') throw fail('ELECTRON_MBT_INVALID_ARGUMENT', 'ipcMain.on');",
    "      (ipcListeners[channel] || (ipcListeners[channel] = [])).push(listener);",
    "    },",
    "    once: function (channel, listener) {",
    "      const self = this;",
    "      function wrapper() { self.removeListener(channel, wrapper); return listener.apply(self, arguments); }",
    "      wrapper.listener = listener;",
    "      this.on(channel, wrapper);",
    "    },",
    "    removeListener: function (channel, listener) {",
    "      const list = ipcListeners[channel];",
    "      if (!list) return;",
    "      for (let i = 0; i < list.length; i++) if (list[i] === listener || list[i].listener === listener) { list.splice(i, 1); break; }",
    "    },",
    "  };",
    "  function hostRequest(operation, payload) {",
    "    if (typeof globalThis.__mbt_host_request !== 'function') throw fail('ELECTRON_MBT_HOST_UNAVAILABLE', operation);",
    "    const raw = globalThis.__mbt_host_request(operation, JSON.stringify(payload || {}));",
    "    if (typeof raw !== 'string') throw fail('ELECTRON_MBT_HOST_RESPONSE', operation);",
    "    const parsed = JSON.parse(raw);",
    "    if (!parsed || parsed.terminal !== 'success') {",
    "      const code = parsed && parsed.payload && parsed.payload.code ? parsed.payload.code : 'ELECTRON_MBT_HOST_FAILURE';",
    "      throw fail(code, operation);",
    "    }",
    "    return parsed.payload || {};",
    "  }",
    "  const windows = [];",
    "  function makeWebContents(owner) {",
    "    const contents = new EventEmitter();",
    "    contents.getTitle = function () { return hostRequest('get-web-contents-title', {}).title || ''; };",
    "    contents.getURL = function () { return hostRequest('get-web-contents-url', {}).url || ''; };",
    "    contents.setWindowOpenHandler = function () {};",
    "    contents.send = function () { throw unsupported('webContents.send'); };",
    "    contents.printToPDF = function () { throw unsupported('webContents.printToPDF'); };",
    "    contents.executeJavaScript = function () { throw unsupported('webContents.executeJavaScript'); };",
    "    contents._owner = owner;",
    "    return contents;",
    "  }",
    "  function BrowserWindow(options) {",
