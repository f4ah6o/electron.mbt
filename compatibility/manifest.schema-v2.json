{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f4ah6o/electron.mbt/compatibility/manifest.schema-v2.json",
  "title": "electron.mbt compatibility manifest v2",
  "description": "Versioned migration target for compatibility/manifest.json. Schema 1 remains the active CLI input until the native CLI migration is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "compatible", "profiles", "rows", "gates", "versions", "limits", "valueProfile"],
  "properties": {
    "schema": { "const": 2 },
    "compatible": { "const": false },
    "profiles": {
      "type": "object",
      "required": ["desktop-core-v1", "electron-nodeless-v1", "electron-nodeless-adapted-v1", "moonbit-native-v1"],
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/row" }
    },
    "gates": { "type": "object" },
    "versions": { "type": "object" },
    "limits": { "type": "object" },
    "valueProfile": { "type": "object" },
    "unsupported": { "type": "array", "items": { "type": "string" } },
    "migratedFrom": {
      "type": "object",
      "required": ["schema", "profile", "milestone"]
    },
    "note": { "type": "string" }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["engine", "runtime", "implementation", "verification", "gate", "compatible", "inputMode", "preloadMode", "scope"],
      "properties": {
        "engine": { "enum": ["node", "quickjs", "moonbit"] },
        "runtime": { "enum": ["node-backed", "quickjs-native", "moonbit-native"] },
        "implementation": { "enum": ["planned", "partial", "implemented", "unsupported"] },
        "verification": { "enum": ["not-run", "invalid-evidence", "failed", "passed"] },
        "gate": { "enum": ["open", "blocked", "satisfied"] },
        "compatible": { "const": false },
        "inputMode": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "preloadMode": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "blockedReason": { "type": ["string", "null"] }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "profile", "area", "scopeLevel", "implementation", "verification", "gate", "tests", "evidence", "gap"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"] },
        "profile": { "enum": ["desktop-core-v1", "electron-nodeless-v1", "electron-nodeless-adapted-v1", "moonbit-native-v1"] },
        "area": { "type": "string" },
        "scopeLevel": { "type": "array", "minItems": 1, "items": { "enum": ["unit", "kernel", "native-ingress", "app-scenario", "release"] } },
        "implementation": { "enum": ["planned", "partial", "implemented", "unsupported"] },
        "verification": { "enum": ["not-run", "invalid-evidence", "failed", "passed"] },
        "gate": { "enum": ["open", "blocked", "satisfied"] },
        "tests": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "gap": { "type": "string", "minLength": 1 }
      }
    }
  }
}
